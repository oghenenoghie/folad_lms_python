# Local (non-Docker) development. Copy to backend/.env; python-decouple/django-environ
# loads it automatically when running manage.py or uvicorn directly on the host.
# Assumes `docker compose up postgres redis minio` (or local installs) reachable at localhost.
#
# For Railway production values, set them in the Railway service's Variables
# tab — never in this file, never committed. See RAILWAY_DEPLOYMENT.md.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# Comma-separated, scheme included, no trailing slash, e.g.
# https://your-app.up.railway.app,https://your-custom-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# Uncomment to use SQLite instead of the Postgres config below — zero local
# setup, but Milestone 2's Row-Level Security only runs on Postgres (the
# app-layer TenantManager still applies either way). See docs/README.md's
# Windows section if Postgres itself is the blocker.
# USE_SQLITE=true

# --- Database ---
# Leave DATABASE_URL unset to use the discrete POSTGRES_* vars below
# (matches docker-compose's local Postgres). Set DATABASE_URL to point this
# checkout at the Neon dev branch instead — get the connection string from
# https://console.neon.tech/app/projects/plain-cell-22374610?database=neondb
#
# MUST be Neon's DIRECT (non-pooled) connection string, e.g.
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# NOT the "-pooler" host. apps/tenancy/context.py sets a session-level
# Postgres GUC (`app.current_org`) that Row-Level Security depends on for
# every request; Neon's pooled endpoint (PgBouncer, transaction-pooling
# mode) does not guarantee that value survives from one transaction to the
# next on the same connection, which would silently break tenant isolation.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# DIRECT_DATABASE_URL=            # optional explicit alias for the same URL; wins over DATABASE_URL if both are set

POSTGRES_DB=sms
POSTGRES_USER=sms
POSTGRES_PASSWORD=sms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Required, not optional: apps/accounts/jwt.py stores refresh-token records
# only in Redis (via Django's cache), and apps/accounts/permissions.py
# caches RBAC lookups there too — login, refresh, and every permission-
# gated API call depend on a reachable Redis. In Railway production this
# needs its own Redis instance (Railway's Redis plugin or an external one
# such as Upstash) — Railway will NOT provision this for you automatically.
REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# JWT_SECRET_KEY=              # falls back to DJANGO_SECRET_KEY if unset

LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MIN=15
MFA_REQUIRED_ROLES=SUPER_ADMIN,SCHOOL_ADMIN

# REQUIRED in any environment where STORAGE_BACKEND=s3 (the default —
# see config.settings.base). Several apps upload real files today: student
# photos (apps.students), report-card PDFs (apps.report_cards), documents
# and assignment submissions (apps.documents/apps.assignments), and exam
# question images (apps.examinations). With STORAGE_BACKEND=s3 and no
# credentials set, STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY default to "" and
# every upload fails with botocore's AuthorizationHeaderMalformed.
#
# Production/staging use Neon Object Storage (bucket "sms-documents" on
# the same Neon project as DATABASE_URL — see RAILWAY_DEPLOYMENT.md §3
# for how to mint a storage:write credential and fill Railway's variables
# in from it). Locally, these point at the docker-compose `minio`
# service instead — real S3-compatible storage with throwaway
# credentials, so save_file()/save_document() work without touching
# Neon. Swap STORAGE_BACKEND=local if you'd rather skip MinIO entirely
# (falls back to Django's local-disk storage — see apps/core/storage.py's
# module docstring).
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=sms-documents
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Declared for a future frontend; no django-cors-headers middleware is
# installed yet (INSTALLED_APPS has no "corsheaders"), so this isn't
# enforced by the Django app today. Never set CORS_ALLOW_ALL_ORIGINS=True
# in production once it is wired up.
CORS_ALLOWED_ORIGINS=
