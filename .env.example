# Docker Compose environment. Copy to .env and adjust before `docker compose up`.
# Values here use in-network service hostnames (postgres, redis, minio) since
# backend-django, backend-fastapi, celery-worker and celery-beat all load this
# file via `env_file:`. For running Django/FastAPI directly on the host outside
# Docker, use backend/.env.example instead (localhost hostnames).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# --- Postgres ---
# POSTGRES_USER/POSTGRES_PASSWORD are the role the app connects as: a
# non-superuser (LOGIN CREATEDB, no BYPASSRLS) that owns POSTGRES_DB, so
# Row-Level Security is enforced locally just like in CI and production.
# The postgres service creates it on first init via
# infrastructure/postgres/initdb/. See docs/README.md, "Database roles".
POSTGRES_DB=sms
POSTGRES_USER=sms_app
POSTGRES_PASSWORD=sms_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Bootstrap superuser of the postgres container, for admin tasks only
# (`docker compose exec postgres psql -U postgres -d sms`). It bypasses RLS,
# so never point POSTGRES_USER at it. Defaults to postgres/postgres; left
# commented out so env_file doesn't hand it to the app containers.
# POSTGRES_SUPERUSER=postgres
# POSTGRES_SUPERUSER_PASSWORD=postgres

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth tokens ---
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# JWT_SECRET_KEY=              # falls back to DJANGO_SECRET_KEY if unset
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MIN=15
MFA_REQUIRED_ROLES=SUPER_ADMIN,SCHOOL_ADMIN

# --- Object storage (MinIO locally; S3/R2 in prod) ---
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=sms-documents
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- CORS (comma-separated, prod only) ---
CORS_ALLOWED_ORIGINS=

# --- Edge ports ---
NGINX_PORT=8080
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
