# Docker Compose environment. Copy to .env and adjust before `docker compose up`.
# Values here use in-network service hostnames (postgres, redis, minio) since
# backend-django, backend-fastapi, celery-worker and celery-beat all load this
# file via `env_file:`. For running Django/FastAPI directly on the host outside
# Docker, use backend/.env.example instead (localhost hostnames).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DB=sms
POSTGRES_USER=sms
POSTGRES_PASSWORD=sms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth tokens ---
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Object storage (MinIO locally; S3/R2 in prod) ---
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=sms-documents
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- CORS (comma-separated, prod only) ---
CORS_ALLOWED_ORIGINS=

# --- Edge ports ---
NGINX_PORT=8080
POSTGRES_PORT_HOST=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
